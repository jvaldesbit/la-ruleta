# URL base de la API. Opcional.
#
# Por defecto el cliente usa la ruta relativa /api/v1 (mismo origen). En
# producción nginx sirve el estático y hace de proxy hacia el backend; en
# desarrollo `pnpm run dev` proxea /api hacia http://localhost:8000.
#
# Defínela solo si el backend vive en otro origen (por ejemplo un despliegue
# remoto). Debe incluir el prefijo /api/v1.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Destino del proxy de desarrollo de Vite (solo afecta a `pnpm run dev`).
# VITE_DEV_BACKEND=http://localhost:8000
